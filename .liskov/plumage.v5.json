{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 5,
  "applicationId": "plumage",
  "metadata": {
    "description": "Two plumage peers on the pinned Qwen3.5-4B model, on phones pinned for inbound IPv6 so the peers can reach each other. Spend caps are Planetarium's.",
    "labels": [
      "plumage",
      "native",
      "inference",
      "ssh"
    ]
  },
  "release": {
    "mode": "pinned",
    "artifact": {
      "digest": "sha256:ed57d35263e1b07761a7234a8b72a860f9a063af3c64a47b58ed23d58fa69047"
    }
  },
  "runtime": {
    "kind": "native_image",
    "image": {
      "catalog": "liskov-runtime-images",
      "name": "debian-trixie",
      "version": "0.1"
    },
    "entrypoint": {
      "executable": "/usr/local/bin/plumage",
      "args": [
        "launch"
      ]
    }
  },
  "execution": {
    "mode": "continuous"
  },
  "deployment": {
    "jobs": 2,
    "schedule": {
      "duration": "2h",
      "phasing": {
        "mode": "evenly_spaced",
        "jobsPerPhase": 1
      }
    },
    "spend": {
      "unit": "service_credit_micros",
      "perJob": "1200000",
      "rate": {
        "amount": "6000000",
        "window": "1d"
      }
    },
    "lifecycle": {
      "renewal": {
        "leadTime": {
          "mode": "automatic"
        }
      },
      "update": {
        "timing": "immediate",
        "existingJobs": {
          "mode": "stop_when_successor_ready"
        }
      }
    },
    "placement": {
      "minimums": {
        "memory": "8GiB",
        "storage": "8GiB"
      },
